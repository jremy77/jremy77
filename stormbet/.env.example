# --- Serveur ---
PORT=3000
NODE_ENV=production
ADMIN_USERNAMES=jremy77            # pseudos qui obtiennent le rôle admin à l'inscription
PUBLIC_HOSTNAME=stormbet.example   # domaine public (obligatoire pour l'embed Twitch "parent=")
INGEST_INTERVAL_MIN=60             # import automatique toutes les N minutes (0 = désactivé)
INGEST_USER_AGENT="StormBetIngest/1.0 (contact: ton-email@exemple.fr)"

# --- Sources de données (toutes optionnelles) ---
LIQUIPEDIA_API_KEY=               # https://liquipedia.net/api (LPDB v3) — tournois, résultats, joueurs
TRN_API_KEY=                      # https://fortnitetracker.com/site-api — points Power Ranking
ESPORTS_EARNINGS_API_KEY=         # https://www.esportsearnings.com/dev — gains en carrière, pays
TWITCH_CLIENT_ID=                 # https://dev.twitch.tv/console — photos de profil + statut live
TWITCH_CLIENT_SECRET=

# --- Lives via le serveur RTMP StormBet (MediaMTX) ---
MEDIA_AUTH_SECRET=change-moi-long-et-aleatoire
RTMP_PUBLIC_URL=rtmp://live.stormbet.example:1935/live
HLS_BASE_URL=https://live.stormbet.example:8888
